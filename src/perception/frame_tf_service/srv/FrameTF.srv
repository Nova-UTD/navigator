# Select Frame TF Options (1 to select an option, 0 for other options)
int32 CAM_TO_WORLD
int32 CAM_TO_PIXEL
int32 WORLD_TO_PIXEL

int32 x
int32 y
int32 z

string camera_name

builtin_interfaces/Time stamp

